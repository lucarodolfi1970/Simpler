<Project Sdk="Microsoft.NET.Sdk">
  <!-- non-regression of the update check: dotnet run --project tools/updatetest -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\app\Simpler\UpdateCheck.cs" Link="UpdateCheck.cs" />
  </ItemGroup>
</Project>
